{
  "name": "@cyanheads/openchargemap-mcp-server",
  "mcpName": "io.github.cyanheads/openchargemap-mcp-server",
  "version": "0.1.5",
  "description": "Find EV charging stations worldwide by location and connector via the global Open Charge Map registry — full station detail, reference-ID resolution, and community reliability check-ins via MCP. STDIO or Streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "openchargemap-mcp-server": "dist/index.js"
  },
  "files": [
    "changelog/",
    "dist/",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md",
    "Dockerfile",
    "server.json"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "rebuild": "bun run scripts/clean.ts && bun run scripts/build.ts",
    "clean": "bun run scripts/clean.ts",
    "devcheck": "bun run scripts/devcheck.ts",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "tree": "bun run scripts/tree.ts",
    "list-skills": "bun run scripts/list-skills.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun run scripts/lint-mcp.ts",
    "lint:packaging": "bun run scripts/lint-packaging.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/openchargemap-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/openchargemap-mcp-server.mcpb",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "release:github": "bun run scripts/release-github.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "open-charge-map",
    "ev-charging",
    "electric-vehicle",
    "charging-stations"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/openchargemap-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/cyanheads/openchargemap-mcp-server/issues"
  },
  "homepage": "https://github.com/cyanheads/openchargemap-mcp-server#readme",
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.11.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/node": "^26.1.2",
    "@vitest/coverage-istanbul": "4.1.10",
    "depcheck": "^1.4.7",
    "ignore": "^7.0.6",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
